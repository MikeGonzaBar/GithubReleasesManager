{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "githubreleasesmanager",
  "version": "0.1.1",
  "identifier": "com.githubreleasesmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitHub Releases Manager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhERkZGQjQ1MjlBMTAzRjgKUldUNEE2RXBSZnYvallMYnFlRzF1eURDU0s2Y0hWTlpIQzhsL1NFUXdFb2RPS3NLU1B5MnNmRUEK",
      "endpoints": [
        "https://github.com/MikeGonzaBar/GithubReleasesManager/releases/latest/download/latest.json"
      ]
    }
  }
}
